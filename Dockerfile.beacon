FROM golang:1.25-alpine AS build
WORKDIR /src
ARG VERSION=3.1.0
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X github.com/localzet/knotroute/internal/overlay.Version=${VERSION}" -o /out/knotroute-beacon ./cmd/knotroute-beacon

FROM scratch
COPY --from=build /out/knotroute-beacon /knotroute-beacon
VOLUME ["/data"]
EXPOSE 8080 7447
ENTRYPOINT ["/knotroute-beacon"]
