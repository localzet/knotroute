FROM golang:1.25-alpine AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/knotroute-control ./cmd/knotroute-control

FROM alpine:3.22
RUN apk add --no-cache ca-certificates qrencode && adduser -D -H -u 10001 knotroute && mkdir -p /data && chown knotroute:knotroute /data
COPY --from=build /out/knotroute-control /usr/local/bin/knotroute-control
USER knotroute
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/knotroute-control"]
