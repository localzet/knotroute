# syntax=docker/dockerfile:1
FROM node:24-alpine AS deps
WORKDIR /app
COPY docs-site/package.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund

FROM node:24-alpine AS build
WORKDIR /app
ARG VERSION=3.1.0
ENV NEXT_PUBLIC_KNOTROUTE_VERSION=${VERSION}
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY docs-site/ ./
RUN npm run build

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
RUN addgroup -S knotroute -g 10001 && adduser -S knotroute -u 10001 -G knotroute
COPY --from=build --chown=knotroute:knotroute /app/public ./public
COPY --from=build --chown=knotroute:knotroute /app/.next/standalone ./
COPY --from=build --chown=knotroute:knotroute /app/.next/static ./.next/static
USER knotroute
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:8080/api/health >/dev/null || exit 1
CMD ["node", "server.js"]
