-function render(){const d=docs[lang];const id=pageId();const p=d.pages[id]||d.pages.start;document.documentElement.lang=lang;document.title=`${p.title} · KnotRoute Docs`;$('#content').innerHTML=`<section class="hero"><div class="eyebrow">${esc(p.tag)}</div><h1>${esc(p.title)}</h1><div class="lead">${esc(p.lead)}</div></section>${p.html}`;$('#crumb').textContent=`KnotRoute / ${p.title}`;$('#lang').textContent=$('#langTop').textContent=lang==='ru'?'RU / EN':'EN / RU';renderNav();window.scrollTo(0,0);$('.sidebar').classList.remove('open')}
